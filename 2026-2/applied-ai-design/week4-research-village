<!DOCTYPE html>
<html lang="ko">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>홈 AI 허브 — 가족의 하루 (실시간)</title>
<style>
:root {
  --bg: #f2efe9; --surface: #ffffff; --surface-2: #ece7de; --border: #ddd6ca;
  --text: #2c2822; --text-muted: #7c7360; --accent: #c1622f; --accent-2: #4d7360;
  --think: #5b6ea3; --data: #8a5ca8;
  --room-bg: #fbfaf6; --room-active: #fff2e4; --shadow: 0 1px 4px rgba(0,0,0,0.08);
  --radius: 12px; --font: -apple-system, BlinkMacSystemFont, "Segoe UI", "Pretendard", "Noto Sans KR", sans-serif;
}
@media (prefers-color-scheme: dark) {
  :root:not([data-theme="light"]) {
    --bg: #1b1915; --surface: #24211c; --surface-2: #2c2822; --border: #3a352c;
    --text: #eae5da; --text-muted: #a39a86; --accent: #e08a58; --accent-2: #7fa08c;
    --think: #8b9fd6; --data: #c39ade; --room-bg: #211e19; --room-active: #332a1f;
    --shadow: 0 1px 4px rgba(0,0,0,0.35);
  }
}
:root[data-theme="dark"] {
  --bg: #1b1915; --surface: #24211c; --surface-2: #2c2822; --border: #3a352c;
  --text: #eae5da; --text-muted: #a39a86; --accent: #e08a58; --accent-2: #7fa08c;
  --think: #8b9fd6; --data: #c39ade; --room-bg: #211e19; --room-active: #332a1f;
  --shadow: 0 1px 4px rgba(0,0,0,0.35);
}
* { box-sizing: border-box; }
body { margin:0; font-family: var(--font); background: var(--bg); color: var(--text); }
.wrap { max-width: 1000px; margin: 0 auto; padding: 18px 14px 60px; }
h1 { font-size: 1.25rem; margin: 0 0 4px; }
.sub { font-size: 0.82rem; color: var(--text-muted); line-height:1.5; margin: 0 0 16px; }

.toolbar { display:flex; flex-wrap: wrap; gap:8px; align-items:center; background: var(--surface); border:1px solid var(--border); border-radius: var(--radius); padding: 10px 12px; margin-bottom: 14px; box-shadow: var(--shadow); }
.toolbar button { border:1px solid var(--border); background: var(--surface-2); color: var(--text); padding: 6px 12px; border-radius: 8px; font-size: 0.8rem; cursor:pointer; }
.toolbar button.primary { background: var(--accent); border-color: var(--accent); color:#fff; }
.toolbar select, .toolbar input[type="date"] { border:1px solid var(--border); border-radius:8px; padding:5px 8px; background:var(--surface-2); color:var(--text); font-size:0.8rem; }
.clock { font-weight:700; font-size:0.95rem; min-width:100px; }
.ai-status { margin-left:auto; font-size:0.74rem; padding:4px 9px; border-radius:999px; border:1px solid var(--border); background:var(--surface-2); white-space:nowrap; }
.ai-status.ok { color:var(--accent-2); border-color:var(--accent-2); }
.ai-status.blocked { color:var(--accent); border-color:var(--accent); font-weight:600; }

.task-row { margin-bottom:8px; }
.task-row .task-label { font-weight:600; font-size:0.8rem; margin-bottom:4px; }
.task-row .task-inputs { display:flex; gap:6px; }
.task-row input { flex:1; border:1px solid var(--border); border-radius:8px; padding:7px 10px; background: var(--surface-2); color:var(--text); font-size:0.82rem; }
.task-row select { border:1px solid var(--border); border-radius:8px; padding:7px 8px; background: var(--surface-2); color:var(--text); font-size:0.82rem; }
.task-row button { border:none; background: var(--accent); color:#fff; border-radius:8px; padding:0 14px; font-size:0.8rem; cursor:pointer; }

.settings-row { display:flex; gap:8px; align-items:center; margin-bottom:8px; }
.settings-row label { font-size:0.75rem; color:var(--text-muted); min-width:64px; }
.settings-row input { flex:1; border:1px solid var(--border); border-radius:6px; padding:6px 8px; background:var(--surface-2); color:var(--text); font-size:0.8rem; }
.persona-edit-group { border-top:1px dashed var(--border); padding-top:8px; margin-top:8px; }
.persona-edit-group h4 { font-size:0.82rem; margin:0 0 6px; }
.persona-edit-row { display:flex; gap:8px; align-items:center; margin-bottom:5px; }
.persona-edit-row label { font-size:0.72rem; color:var(--text-muted); min-width:64px; }
.persona-edit-row input, .persona-edit-row select { flex:1; border:1px solid var(--border); border-radius:6px; padding:5px 8px; background:var(--surface-2); color:var(--text); font-size:0.78rem; }
.persona-edit-notes { align-items:flex-start; }
.persona-edit-notes textarea { flex:1; min-height:44px; border:1px solid var(--border); border-radius:6px; padding:6px 8px; background:var(--surface-2); color:var(--text); font-family:var(--font); font-size:0.78rem; resize:vertical; }

.chip-row { display:flex; flex-wrap:wrap; gap:5px; margin-top:4px; }
.chip { display:inline-block; border:1px solid var(--border); border-radius:999px; padding:2px 8px; font-size:0.68rem; white-space:nowrap; }

.stage { display:grid; grid-template-columns: 1fr 130px; gap:8px; margin-bottom: 14px; position:relative; padding:10px; background:#4a7c3f; border-radius:14px; }
.house {
  display:grid;
  grid-template-columns: 1fr 1fr 1fr 1fr;
  grid-template-rows: 108px 108px 64px 56px;
  grid-template-areas:
    "living living kitchen kitchen"
    "living living bedroom kidsroom"
    ".      yard   yard    bath"
    "entrance . .  .";
  gap:4px;
}
.room[data-room="거실"] { grid-area: living; }
.room[data-room="주방"] { grid-area: kitchen; }
.room[data-room="안방"] { grid-area: bedroom; }
.room[data-room="아이방"] { grid-area: kidsroom; }
.room[data-room="현관"] { grid-area: entrance; }
.room[data-room="마당"] { grid-area: yard; }
.room[data-room="화장실"] { grid-area: bath; }
.room { position:relative; border-radius:3px; overflow:hidden; border:2px solid #3a2a1a; image-rendering:pixelated; background-repeat:repeat; box-shadow: inset 0 0 0 2px rgba(0,0,0,0.15); }
.room.active-hub { border-color: var(--accent); }
.room .wallstrip { position:absolute; top:0; left:0; right:0; height:8px; background-repeat:repeat-x; image-rendering:pixelated; z-index:1; }
.room .room-label { font-size:0.62rem; color:#2c2822; position:absolute; top:12px; left:6px; background:rgba(255,255,255,0.8); padding:1px 5px; border-radius:4px; z-index:3; }
.external { display:flex; flex-direction:column; gap:4px; }
.ext-box { position:relative; border-radius:3px; border:2px solid #3a2a1a; background: repeating-linear-gradient(135deg, #8bc34a, #8bc34a 8px, #7cb342 8px, #7cb342 16px); flex:1; }
.ext-box .room-label { font-size:0.62rem; color:#2c2822; position:absolute; top:6px; left:6px; background:rgba(255,255,255,0.8); padding:1px 5px; border-radius:4px; }

.furn { position:absolute; image-rendering: pixelated; pointer-events:none; z-index:2; }
.furn.bl { left:6px; bottom:6px; }
.furn.br { right:6px; bottom:6px; }
.furn.tr { top:14px; right:6px; }
.furn.bc { left:50%; bottom:6px; transform:translateX(-50%); }
.furn.bg { left:50%; top:56%; transform:translate(-50%,-50%); z-index:0; opacity:0.95; }
.hub-icon { image-rendering: pixelated; z-index:3; }

.room[data-room="거실"]::before { content:''; position:absolute; inset:0; z-index:0; background:rgba(178,132,74,0.16); }
.room[data-room="주방"]::before { content:''; position:absolute; inset:0; z-index:0; background:rgba(110,168,196,0.20); }
.room[data-room="안방"]::before { content:''; position:absolute; inset:0; z-index:0; background:rgba(176,138,196,0.16); }
.room[data-room="아이방"]::before { content:''; position:absolute; inset:0; z-index:0; background:rgba(150,190,110,0.18); }
.room[data-room="화장실"]::before { content:''; position:absolute; inset:0; z-index:0; background:rgba(120,190,214,0.24); }
.room[data-room="현관"]::before { content:''; position:absolute; inset:0; z-index:0; background:rgba(140,140,140,0.14); }
.room::after {
  content:''; position:absolute; inset:0; z-index:0; pointer-events:none;
  background-image:
    repeating-linear-gradient(0deg, rgba(0,0,0,0.09) 0px, rgba(0,0,0,0.09) 1px, transparent 1px, transparent 18px),
    repeating-linear-gradient(90deg, rgba(0,0,0,0.05) 0px, rgba(0,0,0,0.05) 1px, transparent 1px, transparent 48px);
}
.room[data-room="주방"]::after, .room[data-room="화장실"]::after {
  background-image:
    repeating-linear-gradient(0deg, rgba(0,0,0,0.10) 0px, rgba(0,0,0,0.10) 1px, transparent 1px, transparent 14px),
    repeating-linear-gradient(90deg, rgba(0,0,0,0.10) 0px, rgba(0,0,0,0.10) 1px, transparent 1px, transparent 14px);
}
.room[data-room="현관"]::after {
  background-image:
    repeating-linear-gradient(0deg, rgba(0,0,0,0.10) 0px, rgba(0,0,0,0.10) 1px, transparent 1px, transparent 12px),
    repeating-linear-gradient(90deg, rgba(0,0,0,0.10) 0px, rgba(0,0,0,0.10) 1px, transparent 1px, transparent 12px);
}

.hover-popup { position:fixed; transform:translate(-50%,-100%); margin-top:-10px; background:var(--surface); border:1px solid var(--border); border-radius:10px; padding:8px 10px; box-shadow:var(--shadow); font-size:0.72rem; line-height:1.5; max-width:200px; z-index:1000; pointer-events:none; }
.hover-popup .hp-title { font-weight:700; margin-bottom:3px; }
.hover-popup .hp-line { margin-bottom:2px; }
.hover-popup .hp-think { color:var(--think); font-style:italic; }
.hover-popup .hp-data { color:var(--data); font-family:monospace; }
.hover-popup .hp-ai { color:var(--accent-2); font-weight:600; }

.avatar-layer { position:absolute; top:0; left:0; right:0; bottom:0; pointer-events:none; z-index:4; }
.avatar-wrap { position:absolute; width:26px; height:34px; transition: left 1.1s ease, top 1.1s ease; pointer-events:auto; }
.avatar-chip { width:100%; height:100%; display:flex; align-items:flex-end; justify-content:center; cursor:pointer; font-size:1.3rem; background:none; border:none; }
.avatar-chip img { width:100%; height:100%; object-fit:contain; image-rendering:pixelated; filter: drop-shadow(0 2px 1px rgba(0,0,0,0.35)); }
.avatar-chip.loading { opacity:0.55; }
.bubble { position:absolute; bottom:38px; left:50%; transform: translateX(-50%); background: var(--surface); border:1px solid var(--border); border-radius:8px; padding: 3px 6px; font-size: 0.62rem; white-space:nowrap; max-width:150px; overflow:hidden; text-overflow:ellipsis; box-shadow: var(--shadow); z-index:5; }
.bubble.tag-action { color: var(--text); }
.bubble.tag-thought { color: var(--think); font-style:italic; }
.bubble.tag-quote { color: var(--text); font-weight:600; }
.bubble.tag-data { color: var(--data); font-family: monospace; }
.bubble.tag-ai { color: var(--accent-2); font-weight:600; }

.family-list { display:flex; gap:8px; flex-wrap:wrap; margin-bottom: 14px; }
.section-title { font-size:1rem; margin:22px 0 10px; border-top:1px solid var(--border); padding-top:16px; }
.member-card { position:relative; flex:1; min-width:140px; background: var(--surface); border:1.5px solid var(--border); border-radius: var(--radius); padding: 10px; cursor:pointer; box-shadow: var(--shadow); }
.edit-icon { position:absolute; top:6px; right:6px; border:none; background:transparent; cursor:pointer; font-size:0.85rem; padding:2px; line-height:1; }
.member-card.selected { border-color: var(--accent); background: var(--room-active); }
.member-card .mname { font-weight:700; font-size:0.85rem; }
.member-card .mai { font-size:0.7rem; color: var(--text-muted); margin-top:2px; }
.member-card .mstatus { font-size:0.72rem; margin-top:6px; color: var(--text); line-height:1.4; min-height: 2.4em; }

.panels { display:grid; grid-template-columns: 1fr 1fr; gap: 12px; }
.main-grid { display:grid; grid-template-columns: 1fr 260px; gap:16px; align-items:start; }
.main-right details.panel { padding:10px 12px; margin-bottom:10px; }
.main-right summary { cursor:pointer; font-weight:600; font-size:0.82rem; list-style:none; }
.main-right summary::-webkit-details-marker { display:none; }
.main-right summary::before { content:'▸ '; }
.main-right details[open] summary::before { content:'▾ '; }
.main-right summary .hint { font-weight:400; font-size:0.68rem; color:var(--text-muted); }
.main-right details > div { margin-top:8px; }
.drawer-person { font-weight:700; font-size:0.92rem; }
.drawer-subtitle { font-size:0.75rem; color:var(--text-muted); margin:2px 0 10px; }
@media (max-width: 820px) { .main-grid { grid-template-columns: 1fr; } }
@media (max-width: 720px) { .panels { grid-template-columns: 1fr; } .stage { grid-template-columns: 1fr; } .external { flex-direction: row; } }

.panel { background: var(--surface); border:1px solid var(--border); border-radius: var(--radius); padding: 12px; box-shadow: var(--shadow); }
.panel h3 { font-size:0.85rem; margin:0 0 8px; }
.log-item { border-left:2px solid var(--border); padding: 5px 0 5px 10px; margin-bottom:6px; font-size:0.76rem; }
.log-item .lmeta { color: var(--text-muted); font-size:0.68rem; }
.empty { color: var(--text-muted); font-size: 0.78rem; }

.drawer { margin-top: 14px; }
.tabs { display:flex; gap:6px; margin-bottom:10px; }
.tab-btn { border:1px solid var(--border); background: var(--surface-2); color:var(--text); padding:6px 12px; border-radius:999px; font-size:0.78rem; cursor:pointer; }
.tab-btn.active { background: var(--accent); border-color:var(--accent); color:#fff; }
.tab-content { display:none; }
.tab-content.active { display:block; }
textarea.qbox { width:100%; min-height:50px; border:1px solid var(--border); border-radius:8px; padding:8px; background:var(--surface-2); color:var(--text); font-family:var(--font); font-size:0.82rem; }
.small-btn { border:none; background: var(--accent); color:#fff; padding:7px 14px; border-radius:8px; font-size:0.8rem; cursor:pointer; margin-top:6px; }
.answer-box { margin-top:10px; background: var(--surface-2); border-radius:8px; padding:10px; font-size:0.82rem; line-height:1.6; white-space:pre-wrap; }
.banner { background: var(--room-active); border:1px solid var(--accent); border-radius:8px; padding:8px 12px; font-size:0.8rem; margin-bottom:12px; display:none; }
</style>
</head>
<body>
<div class="wrap">
  <h1>🏠 홈 AI 허브 — 가족의 하루 (실시간 시뮬레이션)</h1>
  <p class="sub"></p>

  <div class="banner" id="dayEndBanner">🌙 오늘 하루 시뮬레이션이 종료되었습니다 (22:00). "하루 다시 시작"을 눌러주세요.</div>

  <div class="toolbar">
    <button class="primary" id="playBtn">▶ 재생</button>
    <button id="restartBtn">🔁 하루 다시 시작</button>
    <select id="speedSel">
      <option value="1" selected>1x</option>
      <option value="3">3x</option>
      <option value="8">8x</option>
    </select>
    <div class="clock" id="clockLabel">대기 중</div>
    <input type="date" id="simDateInput">
    <button id="settingsBtn">🧑‍🤝‍🧑 퍼소나</button>
    <button id="aiRetryBtn" title="대기 시간을 건너뛰고 지금 바로 AI 연결을 다시 시도합니다">🔄 AI 재연결</button>
    <span class="ai-status" id="aiStatus" title="AI 연동 상태">⚪ AI 상태 확인 중</span>
  </div>

  <div class="panel" id="settingsPanel" style="display:none;">
    <h3>🧑‍🤝‍🧑 퍼소나 · 기기 편집</h3>
    <div class="settings-row"><label>가족 상황</label><input id="setSituation" type="text"></div>
    <div class="settings-row"><label>보유 기기</label><input id="setDevices" type="text"></div>
    <div id="personaEditList"></div>
    <button class="small-btn" id="saveSettingsBtn">저장</button>
  </div>

  <div class="task-row">
    <div class="task-label">🧩 Context 입력</div>
    <div class="task-inputs">
      <select id="taskTarget" title="이 상황을 누구에게 일으킬지 선택">
        <option value="all">👪 가족 전체</option>
        <option value="mom">👩 엄마</option>
        <option value="dad">👨‍💻 아빠</option>
        <option value="kid">🧒 아이</option>
      </select>
      <input type="text" id="taskInput" placeholder="예: 할머니가 전화를 걸어옴 / 급한 업무 메시지를 받음">
      <button id="taskBtn">지금 반영</button>
    </div>
    <div class="chip-row" id="contextChips"></div>
  </div>

  <div class="stage" id="stage">
    <div class="house" id="houseGrid"></div>
    <div class="external" id="externalZone"></div>
    <div class="avatar-layer" id="avatarLayer"></div>
  </div>

  <div class="main-grid">
    <div class="main-left">
      <h2 class="section-title" style="margin-top:0;">🔬 리서치</h2>
      <div class="family-list" id="familyList"></div>

      <div class="panel drawer" id="drawer">
        <div class="drawer-person" id="drawerPerson">가족 구성원을 선택하세요</div>
        <div class="drawer-subtitle">🔬 리서치</div>
        <div class="tabs">
          <button class="tab-btn active" data-tab="obs">관찰</button>
          <button class="tab-btn" data-tab="interview">인터뷰</button>
          <button class="tab-btn" data-tab="personal">개인데이터</button>
          <button class="tab-btn" data-tab="survey">설문</button>
          <button class="tab-btn" data-tab="diary">다이어리</button>
        </div>
        <div class="tab-content active" id="tab-obs"><div class="empty">아직 선택된 인물이 없습니다.</div></div>
        <div class="tab-content" id="tab-interview">
          <textarea class="qbox" id="interviewInput" placeholder="이 인물에게 물어볼 질문을 입력하세요"></textarea>
          <button class="small-btn" id="interviewBtn">질문하기</button>
          <div class="answer-box" id="interviewAnswer" style="display:none;"></div>
        </div>
        <div class="tab-content" id="tab-personal"><div class="empty">아직 선택된 인물이 없습니다.</div></div>
        <div class="tab-content" id="tab-survey">
          <textarea class="qbox" id="surveyQuestionsInput" placeholder="설문 문항을 한 줄에 하나씩 입력하세요"></textarea>
          <button class="small-btn" id="surveyBtn">설문 응답 받기</button>
          <div class="answer-box" id="surveyAnswer" style="display:none;"></div>
        </div>
        <div class="tab-content" id="tab-diary">
          <div class="settings-row" id="diaryImageRow" style="display:none;">
            <label>사진 첨부</label>
            <input type="file" id="diaryImageInput" accept="image/*" multiple>
          </div>
          <div class="chip-row" id="diaryImagePreview"></div>
          <button class="small-btn" id="diaryBtn">지금까지의 다이어리 쓰기</button>
          <div class="answer-box" id="diaryAnswer" style="display:none;"></div>
        </div>
      </div>
    </div>

    <aside class="main-right">
      <h2 class="section-title" style="margin-top:0;">📊 데이터</h2>
      <details class="panel" open>
        <summary>가족 데이터 로그 <span class="hint">(개인화용 데이터 포인트)</span></summary>
        <div id="dataLog"><div class="empty">시뮬레이션이 진행되면 여기 쌓입니다.</div></div>
      </details>
      <details class="panel">
        <summary>🗒️ 이벤트 로그</summary>
        <div id="eventLog"><div class="empty">아직 던진 상황이 없습니다.</div></div>
      </details>
      <details class="panel">
        <summary>⚠️ 시스템 로그</summary>
        <div id="systemLog"><div class="empty">아직 오류가 없습니다.</div></div>
      </details>
    </aside>
  </div>
</div>

<script>
const ROOMS = ['현관','거실','주방','안방','아이방','마당','화장실'];
const EXTERNAL = ['회사','학교','외출'];
const DAY_START = 360, DAY_END = 1320;
const OFFSETS = { dad:{dx:-16,dy:-10}, mom:{dx:16,dy:-10}, kid:{dx:0,dy:14}, dog:{dx:0,dy:-18} };

const FURN_IMG = {
  coatRackStanding: 'data:image/png;base64,',
