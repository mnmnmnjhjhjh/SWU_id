function fmtClock(min){
  let h = Math.floor(min/60), m = min%60;
  const ampm = h < 12 ? '오전' : '오후';
  let h12 = h % 12; if (h12===0) h12=12;
  return `${ampm} ${h12}:${String(m).padStart(2,'0')}`;
}
function escapeHtml(s){ return (s||'').replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;'); }


function furnHtml(roomName){
  const items = FURNITURE[roomName];
  if (!items) return '';
  return items.map(it => `<img class="furn ${it.pos}" style="width:${it.w}px;height:auto;" src="${FURN_IMG[it.img]}" alt="">`).join('');
}

function buildHouse(){
  const houseGrid = document.getElementById('houseGrid');
  houseGrid.innerHTML = ROOMS.map(r => `
    <div class="room ${r==='거실'?'active-hub':''}" data-room="${r}" style="background-image:url('${TILE_IMG.floorFull}');background-size:32px 32px;">
      <div class="wallstrip" style="background-image:url('${TILE_IMG.wallStrip}');background-size:32px 8px;"></div>
      <div class="room-label">${r}</div>
      ${r==='거실' ? `<img class="hub-icon" style="position:absolute;top:12px;right:8px;width:14px;height:auto;" src="${FURN_IMG.speaker}" alt="">` : ''}
      ${furnHtml(r)}
    </div>`).join('');
  const ext = document.getElementById('externalZone');
  ext.innerHTML = EXTERNAL.map(r => `<div class="ext-box" data-room="${r}"><div class="room-label">${r}</div></div>`).join('');

  const layer = document.getElementById('avatarLayer');
  layer.innerHTML = '';
  ['dad','mom','kid','dog'].forEach(id => {
    const wrap = document.createElement('div');
    wrap.className = 'avatar-wrap';
    const name = id==='dog' ? '강아지 보리' : displayName(id);
    const inner = id==='dog' ? '🐶' : `<img src="${CHAR_IMG[id]}" alt="${name}">`;
    wrap.innerHTML = `<div class="avatar-chip" title="${name}">${inner}</div>`;
    const chipEl = wrap.querySelector('.avatar-chip');
    chipEl.onclick = () => { if (id!=='dog') selectPersona(id); };
    chipEl.addEventListener('mouseenter', () => showHoverPopup(id));
    chipEl.addEventListener('mouseleave', hideHoverPopup);
    layer.appendChild(wrap);
    state.avatarEls[id] = wrap;
  });
}

function buildFamilyList(){
  const el = document.getElementById('familyList');
  const ids = ['mom','dad','kid'];
  el.innerHTML = ids.map(id => `
    <div class="member-card" data-id="${id}">
      <button class="edit-icon" data-edit="${id}" title="편집">✏️</button>
      <div class="mname">${PERSONAS[id].emoji} ${displayName(id)}</div>
      <div class="mai">AI 친숙도: ${PERSONAS[id].aiLevel}</div>
      <div class="mstatus" id="status-${id}">대기 중...</div>
    </div>`).join('');
  el.querySelectorAll('.member-card').forEach(card => { card.onclick = () => selectPersona(card.dataset.id); });
  el.querySelectorAll('.edit-icon').forEach(btn => {
    btn.onclick = (e) => { e.stopPropagation(); openSettings(); };
  });
}

function getRoomCenter(roomName){
  const el = document.querySelector(`[data-room="${roomName}"]`);
  const stage = document.getElementById('stage');
  if (!el) return {x:0,y:0};
  const er = el.getBoundingClientRect(), sr = stage.getBoundingClientRect();
  return { x: er.left - sr.left + er.width/2 - 13, y: er.top - sr.top + er.height/2 - 17 };
}

function positionAvatar(id, roomName){
  const wrap = state.avatarEls[id];
  if (!wrap) return;
  const c = getRoomCenter(roomName || '거실');
  const off = OFFSETS[id] || {dx:0,dy:0};
  wrap.style.left = (c.x + off.dx) + 'px';
  wrap.style.top = (c.y + off.dy) + 'px';
}

function renderBubble(id, obj, loading){
  const wrap = state.avatarEls[id];
  if (!wrap) return;
  const chip = wrap.querySelector('.avatar-chip');
  chip.classList.toggle('loading', !!loading);
  let text = '';
  if (!loading && obj) {
    text = obj.action || obj.quote || '';
    if (text && obj.ai_interaction) text += ' 🔊';
  }
  let bubbleEl = wrap.querySelector('.bubble');
  if (!text) {
    if (bubbleEl) bubbleEl.remove();
    return;
  }
  if (bubbleEl) {
    if (bubbleEl.textContent !== text) bubbleEl.textContent = text;
  } else {
    bubbleEl = document.createElement('div');
    bubbleEl.className = 'bubble tag-action';
    bubbleEl.textContent = text;
    wrap.appendChild(bubbleEl);
  }
}

function buildPrompt(id, extraContext){
  const others = ['mom','dad','kid'].filter(x=>x!==id).map(x => {
    const c = state.people[x].current;
    return `- ${displayName(x)}: ${c ? c.location : '알 수 없음'}`;
  }).join('\n');
  const dogLoc = state.dog.current ? state.dog.current.location : '거실';
  const log = state.people[id].log.slice(-8);
  const memoryText = log.length ? log.map(b => `${b.time} [${b.location}] ${b.action}`).join('\n') : '(아직 없음, 오늘의 첫 행동)';
  return `당신은 UX 리서치를 위해 미국 중산층 가정 구성원 한 명의 다음 행동을 실시간으로 하나씩 결정합니다.

[가족 상황] ${FAMILY_CONTEXT.situation}
[보유 기기] ${FAMILY_CONTEXT.devices}
[날짜] ${simDateStr} (${isWeekendDate(simDateStr) ? '주말' : '평일'}) — 주말이면 아빠도 회사에 가지 않고, 아이도 학교에 가지 않는 등 평소와 다른 리듬을 반영하세요.

[이 인물]
${personaText(id)}

[지금 시각] ${fmtClock(state.simMinutes)}
[장소 목록] 현관, 거실, 주방, 안방, 아이방, 화장실, 마당, 회사, 학교, 외출 중에서만 고르세요

[다른 가족 구성원 현재 위치]
${others}
- 강아지: ${dogLoc}

[최근 행동 기록 (오래된 순)]
${memoryText}

${extraContext ? '[지금 이 사람에게 막 일어난 일] '+extraContext+'\n이 일에 대한 즉각적인 반응을 다음 행동으로 삼으세요. 하던 일을 중단하거나 장소를 옮겨도 좋습니다.' : ''}

다음에 할 행동 하나를 결정하세요. 이전 행동과 자연스럽게 이어지고, 하루 리듬(아침 준비→출근/등교→낮 활동→퇴근/하교→저녁→취침 준비)을 따르세요. 22:00에 가까워질수록 잠자리에 들 준비로 수렴하세요.

JSON으로만 답하세요:
{"location":"...","duration_minutes":15~90 사이 정수,"action":"...","thought":"...","quote":"...","attitude":"이 순간의 태도를 형용사구로 짧게 (예: 시큰둥함, 적극적)","emotion":"이 순간의 감정을 한 단어로 (예: 짜증, 만족, 무심함)","data_tag":"...","ai_interaction":"..."}`;
}

function aiErrorText(e){
  const code = e && e.code ? e.code : 'unknown';
  if (code === 'rate_limited') return '지금 AI 호출이 일시적으로 막혀 있습니다 (rate_limited). 툴바의 AI 상태를 확인하고 잠시 후 다시 눌러주세요.';
  if (code === 'not_granted' || code === 'sampling_disabled' || code === 'not_declared') return '이 화면에서는 AI를 쓸 수 없습니다. 대화 안에 열린 아티팩트 화면에서 다시 시도해주세요.';
  return '오류: ' + (e && e.message ? e.message : '알 수 없음') + ' (' + code + ')';
}

function noteAiFailure(e){
  const code = e && e.code ? e.code : 'unknown';
  state.systemLog.unshift({ time: fmtClock(Math.floor(state.simMinutes)), text: `⚠️ 리서치 요청 실패 (${code})` });
  renderSystemLog();
  if (code === 'not_granted' || code === 'sampling_disabled' || code === 'not_declared'){ sample = null; setAiStatus('none'); }
  else setAiStatus('blocked', code);
}

function setAiStatus(kind, detail){
  state.aiKind = kind;
  state.aiDetail = detail || '';
  renderAiStatus();
}

function renderAiStatus(){
  const el = document.getElementById('aiStatus');
  if (!el) return;
  const kind = state.aiKind;
  el.className = 'ai-status' + (kind === 'ok' ? ' ok' : kind === 'blocked' ? ' blocked' : '');
  if (kind === 'ok'){
    el.textContent = '🟢 AI 연동됨';
    el.title = 'AI가 인물의 행동을 직접 생성하고 있습니다.';
  } else if (kind === 'trying'){
    el.textContent = '⏳ AI 다시 연결하는 중';
    el.title = '다음 행동을 AI로 만들어보는 중입니다.';
  } else if (kind === 'blocked'){
    const waits = ['mom','dad','kid'].map(id => (state.people[id].retryAfter || 0) - Date.now()).filter(v => v > 0);
    const secs = waits.length ? Math.ceil(Math.min.apply(null, waits) / 1000) : 0;
    el.textContent = `🟡 AI 차단됨 (${state.aiDetail}) — ${secs > 0 ? secs + '초 후 재시도' : '재시도 중'} · 기본 시나리오 진행`;
    el.title = '인터뷰·설문·다이어리도 지금은 응답하지 않습니다. 기다리거나 "AI 재연결"을 눌러보세요.';
  } else {
    el.textContent = '⚪ AI 없음 — 기본 시나리오로 진행 중';
    el.title = '이 화면에서는 AI를 쓸 수 없습니다. 대화 안에 열린 아티팩트 화면에서 열어야 AI가 붙습니다.';
  }
}

async function retryAi(){
  if (!sample && window.claude){
    try { sample = await claude.use('sample'); } catch(e){ sample = null; }
  }
  if (!sample){ setAiStatus('none'); return; }
  ['mom','dad','kid'].forEach(id => {
    const p = state.people[id];
    p.retryAfter = 0;
    p.failStreak = 0;
    if (p.current) p.current.endMin = state.simMinutes;   // 다음 틱에 곧바로 AI로 다시 시도
  });
  setAiStatus('trying');
}

// AI가 막혔을 때 쓸 기본 시나리오 블록
function routineBlock(id, minutes){
  const list = ROUTINE[id] || [];
  if (!list.length) return null;
  let idx = 0;
  for (let i = 0; i < list.length; i++){ if (list[i].at <= minutes) idx = i; }
  const pick = list[idx];
  const next = list[idx + 1] || null;
  const endAt = next ? next.at : DAY_END;
  return {
    time: fmtClock(minutes),
    location: pick.location, action: pick.action, thought: pick.thought, quote: pick.quote,
    attitude: pick.attitude, emotion: pick.emotion, data_tag: pick.data_tag, ai_interaction: pick.ai_interaction,
    context_tag: '', scripted_tag: '기본 시나리오',
    startMin: minutes, endMin: Math.max(minutes + 12, endAt)
  };
}

function applyRoutine(id){
  const person = state.people[id];
  const block = routineBlock(id, state.simMinutes);
  if (!block) return;
  person.log.push(block);
  if (person.log.length > 40) person.log.shift();
  person.current = block;
  if (block.data_tag) state.dataLog.unshift({ time:block.time, name:displayName(id), text:'📄 '+block.data_tag });
  if (block.ai_interaction) state.dataLog.unshift({ time:block.time, name:displayName(id), text:'📄 🔊 '+block.ai_interaction });
  renderDataLog();
}

function fallbackStep(id){
  applyRoutine(id);
  state.people[id].fetching = false;
  renderOne(id);
  if (state.selected === id){ renderDrawer(); renderPersonalTab(); }
}

async function decideNext(id, extraContext, isUserContext=false, force=false){
  if (state.doneForDay) return;
  const person = state.people[id];
  // AI를 못 쓰거나 아직 재시도 대기 중이면 기본 시나리오로 계속 움직인다
  // (force = 사용자가 직접 넣은 Context — 대기 시간을 건너뛴다)
  if (!sample || (!force && person.retryAfter && Date.now() < person.retryAfter)){ fallbackStep(id); return; }
  person.fetching = true;
  renderBubble(id, person.current, true);
  try {
    const res = await sample.json(buildPrompt(id, extraContext), { modelTier:'quick' });
    const startMin = state.simMinutes;
    const minDur = isUserContext ? 10 : 40;   // 사용자가 넣은 상황은 짧게 반응해도 자연스럽다
    const dur = Math.max(minDur, Math.min(120, Number(res.duration_minutes)||45)) + Math.floor(Math.random()*20);
    const block = {
      time: fmtClock(startMin),
      location: ROOMS.concat(EXTERNAL).includes(res.location) ? res.location : '거실',
      action: res.action||'', thought: res.thought||'', quote: res.quote||'',
      attitude: res.attitude||'', emotion: res.emotion||'',
      data_tag: res.data_tag||'', ai_interaction: res.ai_interaction||'',
      context_tag: isUserContext && extraContext ? extraContext : '',
      startMin, endMin: startMin + dur
    };
    person.log.push(block);
    if (person.log.length > 40) person.log.shift();
    person.current = block;
    if (block.data_tag) state.dataLog.unshift({ time:block.time, name:displayName(id), text:block.data_tag });
    if (block.ai_interaction) state.dataLog.unshift({ time:block.time, name:displayName(id), text:'🔊 '+block.ai_interaction });
    person.failStreak = 0;
    setAiStatus('ok');
    renderDataLog();
  } catch(e){
    console.error(e);
    const code = e && e.code ? e.code : 'unknown';
    person.failStreak = (person.failStreak || 0) + 1;
    state.systemLog.unshift({ time: fmtClock(Math.floor(state.simMinutes)), text: `⚠️ ${displayName(id)} 응답 실패 (${code}) — 기본 시나리오로 진행하고 잠시 후 다시 시도합니다.` });
    renderSystemLog();
    if (code === 'not_granted' || code === 'sampling_disabled' || code === 'not_declared'){
      sample = null;               // 되살아날 수 없는 상태 — 더 부르지 않고 시나리오로만 진행
      setAiStatus('none');
    } else {
      setAiStatus('blocked', code);
      const baseMs = code === 'rate_limited' ? 15000 : 6000;
      const backoffMs = Math.min(180000, baseMs * Math.pow(2, person.failStreak - 1)) + Math.random()*4000;
      person.retryAfter = Date.now() + backoffMs;
    }
    applyRoutine(id);
  }
  person.fetching = false;
  renderOne(id);
  if (state.selected === id) { renderDrawer(); renderPersonalTab(); }
  if (person.pendingContext){
    const queued = person.pendingContext;
    person.pendingContext = null;
    decideNext(id, queued, true, true);
  }
}

function renderOne(id){
  const person = state.people[id];
  positionAvatar(id, person.current ? person.current.location : '거실');
  renderBubble(id, person.current, person.fetching);
  const statusEl = document.getElementById('status-'+id);
  if (statusEl && person.current) statusEl.textContent = `${person.current.scripted_tag ? '📄 ' : ''}[${person.current.location}] ${person.current.action}`;
}

function renderDog(){
  positionAvatar('dog', state.dog.current ? state.dog.current.location : '거실');
  renderBubble('dog', state.dog.current ? {action: state.dog.current.action} : null, false);
}

function renderDataLog(){
  const el = document.getElementById('dataLog');
  if (!state.dataLog.length){ el.innerHTML = '<div class="empty">시뮬레이션이 진행되면 여기 쌓입니다.</div>'; return; }
  el.innerHTML = state.dataLog.slice(0,30).map(d => `<div class="log-item"><div class="lmeta">${d.time} · ${d.name}</div>${escapeHtml(d.text)}</div>`).join('');
}
function renderEventLog(){
  const el = document.getElementById('eventLog');
  const chipsEl = document.getElementById('contextChips');
  chipsEl.innerHTML = state.eventLog.map(e => `<span class="chip" title="${e.time}">🧩 ${escapeHtml(e.text)}</span>`).join('');
  if (!state.eventLog.length){ el.innerHTML = '<div class="empty">아직 던진 상황이 없습니다.</div>'; return; }
  el.innerHTML = state.eventLog.map(e => `<div class="log-item"><div class="lmeta">${e.time}</div>${escapeHtml(e.text)}</div>`).join('');
}
function renderSystemLog(){
  const el = document.getElementById('systemLog');
  if (!state.systemLog.length){ el.innerHTML = '<div class="empty">아직 오류가 없습니다.</div>'; return; }
  el.innerHTML = state.systemLog.map(e => `<div class="log-item"><div class="lmeta">${e.time}</div>${escapeHtml(e.text)}</div>`).join('');
}

function loopTick(){
  if (state.playing && !state.doneForDay){
    state.simMinutes += state.speed * 0.3;
    if (state.simMinutes >= DAY_END){
      state.simMinutes = DAY_END;
      state.doneForDay = true;
      state.playing = false;
      document.getElementById('playBtn').textContent = '▶ 재생';
      document.getElementById('dayEndBanner').style.display = 'block';
    }
    document.getElementById('clockLabel').textContent = fmtClock(Math.floor(state.simMinutes));

    ['mom','dad','kid'].forEach(id => {
      const person = state.people[id];
      if (!person.fetching && (!person.current || state.simMinutes >= person.current.endMin)){
        decideNext(id);
      }
    });
    if (!state.dog.current || state.simMinutes >= state.dog.current.endMin){
      const idx = state.dog.idx % DOG_SCRIPT.length;
      const s = DOG_SCRIPT[idx];
      state.dog.current = { location:s.location, action:s.action, startMin: state.simMinutes, endMin: state.simMinutes + s.duration };
      state.dog.idx++;
    }
  }
  ['mom','dad','kid'].forEach(renderOne);
  renderDog();
  renderAiStatus();
}

async function injectTask(){
  const taskText = document.getElementById('taskInput').value.trim();
  if (!taskText) return;
  if (state.doneForDay){ alert('하루가 종료되었습니다. 다시 시작해주세요.'); return; }
  const target = document.getElementById('taskTarget').value;
  const ids = target === 'all' ? ['mom','dad','kid'] : [target];

  state.eventLog.unshift({
    time: fmtClock(Math.floor(state.simMinutes)),
    text: (target === 'all' ? '👪 전체' : displayName(target)) + ' · ' + taskText
  });
  renderEventLog();
  document.getElementById('taskInput').value = '';

  if (!sample){
    state.systemLog.unshift({ time: fmtClock(Math.floor(state.simMinutes)), text: '⚠️ AI가 연결되지 않아 이 Context는 행동에 반영되지 않았습니다 (기록만 남음)' });
    renderSystemLog();
    return;
  }

  ids.forEach((id, i) => {
    const person = state.people[id];
    if (person.fetching){ person.pendingContext = taskText; return; }  // 진행 중인 호출이 끝나면 곧바로 반영
    person.fetching = true;
    renderBubble(id, person.current, true);
    setTimeout(() => decideNext(id, taskText, true, true), ids.length > 1 ? i * 900 : 0);
  });
}

function selectPersona(id){
  if (state.selected === id) { deselectPersona(); return; }
  state.selected = id;
  document.querySelectorAll('.member-card').forEach(c => c.classList.toggle('selected', c.dataset.id===id));
  document.getElementById('drawerPerson').textContent = `${PERSONAS[id].emoji} ${displayName(id)}`;
  document.getElementById('interviewAnswer').style.display = 'none';
  document.getElementById('diaryAnswer').style.display = 'none';
  document.getElementById('surveyAnswer').style.display = 'none';
  document.getElementById('diaryImageInput').value = '';
  document.getElementById('diaryImagePreview').innerHTML = '';
  renderDrawer();
  renderPersonalTab();
}

function deselectPersona(){
  state.selected = null;
  document.querySelectorAll('.member-card').forEach(c => c.classList.remove('selected'));
  document.getElementById('drawerPerson').textContent = '가족 구성원을 선택하세요';
  document.getElementById('interviewAnswer').style.display = 'none';
  document.getElementById('diaryAnswer').style.display = 'none';
  document.getElementById('surveyAnswer').style.display = 'none';
  document.getElementById('diaryImageInput').value = '';
  document.getElementById('diaryImagePreview').innerHTML = '';
  document.getElementById('tab-obs').innerHTML = '<div class="empty">아직 선택된 인물이 없습니다.</div>';
  document.getElementById('tab-personal').innerHTML = '<div class="empty">아직 선택된 인물이 없습니다.</div>';
}

const TAG_CHIP = {
  scripted_tag: ['📄 AI 아님', 'var(--text-muted)'],
  context_tag: ['🧩 Context', 'var(--accent)'],
  action: ['🎬 행동', ''], thought: ['💭 생각', 'var(--think)'], quote: ['🗣️ 말', ''],
  attitude: ['🧭 태도', 'var(--accent)'], emotion: ['❤️ 감정', 'var(--accent-2)'],
  data_tag: ['📊 데이터', 'var(--data)'], ai_interaction: ['🔊 AI허브', 'var(--accent-2)']
};
function tagChipsHtml(b){
  const order = ['scripted_tag','context_tag','action','thought','quote','attitude','emotion','data_tag','ai_interaction'];
  return order.filter(k => b[k]).map(k => {
    const [label, color] = TAG_CHIP[k];
    return `<span class="chip"${color ? ' style="color:'+color+';border-color:'+color+'"' : ''}>[${label}] ${escapeHtml(b[k])}</span>`;
  }).join('');
}

function renderDrawer(){
  const id = state.selected;
  if (!id) return;
  const person = state.people[id];
  const obsEl = document.getElementById('tab-obs');
  const items = person.log.slice().reverse();
  if (!items.length){ obsEl.innerHTML = '<div class="empty">아직 관찰된 행동이 없습니다.</div>'; return; }
  obsEl.innerHTML = items.map(b => `
    <div class="log-item">
      <div class="lmeta">${b.time} · ${b.location}</div>
      <div class="chip-row">${tagChipsHtml(b)}</div>
    </div>`).join('');
}

function renderPersonalTab(){
  const id = state.selected;
  if (!id) return;
  const el = document.getElementById('tab-personal');
  const name = displayName(id);
  const items = state.dataLog.filter(d => d.name === name);
  if (!items.length){ el.innerHTML = '<div class="empty">아직 수집된 개인 데이터가 없습니다.</div>'; return; }
  el.innerHTML = items.map(d => `<div class="log-item"><div class="lmeta">${d.time}</div>${escapeHtml(d.text)}</div>`).join('');
}

function logSummaryText(id){
  return state.people[id].log.map(b => `${b.time} [${b.location}] ${b.action}${b.thought?' (속마음: '+b.thought+')':''}${b.attitude?' (태도: '+b.attitude+')':''}${b.emotion?' (감정: '+b.emotion+')':''}${b.ai_interaction?' [AI허브: '+b.ai_interaction+']':''}`).join('\n');
}

const SURVEY_QUESTIONS = [
  '집에 있는 HomeSense Hub를 하루에 얼마나 자주 쓰나요?',
  '가장 유용하다고 느끼는 기능은 무엇인가요?',
  'HomeSense Hub를 쓰면서 답답하거나 불편했던 순간이 있나요?',
  'AI가 내 하루 일정이나 습관을 미리 파악해서 알아서 해주는 것에 대해 어떻게 생각하나요?',
  '이 집에 없지만 있었으면 하는 AI 기능이 있다면?'
];

async function doSurvey(){
  const id = state.selected;
  if (!id || !sample) return;
  const questions = document.getElementById('surveyQuestionsInput').value
    .split('\n').map(s => s.trim()).filter(Boolean);
  if (!questions.length){ alert('설문 문항을 입력해주세요.'); return; }
  const ansEl = document.getElementById('surveyAnswer');
  ansEl.style.display = 'block';
  ansEl.textContent = '응답 중...';
  const qList = questions.map((q,i) => `${i+1}. ${q}`).join('\n');
  const prompt = `당신은 아래 페르소나가 되어 설문에 응답합니다.

[페르소나]
${personaText(id)}

[오늘 지금까지의 관찰 기록]
${logSummaryText(id) || '(아직 없음)'}

[설문 문항]
${qList}

각 문항에 "답변"과 "이유(1문장)"를 페르소나 성격에 맞게 작성하세요. JSON으로만 답하세요:
{"answers":[{"question":"...","answer":"...","reason":"..."}]}`;
  try {
    const res = await sample.json(prompt, { modelTier:'default' });
    setAiStatus('ok');
    ansEl.textContent = (res.answers||[]).map((a,i) => `${i+1}. ${a.question}\n→ ${a.answer} (${a.reason})`).join('\n\n');
  } catch(e){ noteAiFailure(e); ansEl.textContent = aiErrorText(e); }
}

async function doInterview(){
  const id = state.selected;
  const q = document.getElementById('interviewInput').value.trim();
  if (!id || !q || !sample) return;
  const ansEl = document.getElementById('interviewAnswer');
  ansEl.style.display = 'block';
  ansEl.textContent = '생각하는 중...';
  const prompt = `당신은 아래 페르소나가 되어 1인칭으로 인터뷰에 답합니다.

[페르소나]
${personaText(id)}

[오늘 지금까지의 관찰 기록]
${logSummaryText(id) || '(아직 없음)'}

[규칙] 한국어, 1인칭, 2~5문장, 위 기록과 일관되게 답하세요. 메타 발언 금지.

연구자: ${q}
${displayName(id)}:`;
  try {
    const res = await sample(prompt, { modelTier:'default' });
    setAiStatus('ok');
    ansEl.textContent = res.text.trim();
  } catch(e){ noteAiFailure(e); ansEl.textContent = aiErrorText(e); }
}

async function doDiary(){
  const id = state.selected;
  if (!id || !sample) return;
  const ansEl = document.getElementById('diaryAnswer');
  ansEl.style.display = 'block';
  ansEl.textContent = '쓰는 중...';
  const imgInput = document.getElementById('diaryImageInput');
  const files = imgInput && imgInput.files && imgInput.files.length ? imgInput.files : null;
  const prompt = `당신은 아래 페르소나가 되어 오늘 하루(지금까지)를 1인칭 일기체로 씁니다.

[페르소나]
${personaText(id)}

[오늘 지금까지의 관찰 기록]
${logSummaryText(id) || '(아직 없음)'}

150~300자, 한국어, 일기체로 쓰세요. HomeSense Hub와 관련된 감정을 한 번은 자연스럽게 담으세요.${files ? '\n\n첨부된 사진이 있습니다. 사진 속 내용을 이 페르소나가 오늘 실제로 보거나 겪은 장면으로 자연스럽게 일기에 녹여내세요.' : ''}`;
  try {
    const opts = { modelTier:'default' };
    if (files) opts.images = files;
    const res = await sample(prompt, opts);
    setAiStatus('ok');
    ansEl.textContent = res.text.trim();
  } catch(e){
    noteAiFailure(e);
    ansEl.textContent = e && e.code === 'image_rejected'
      ? '첨부한 사진을 처리할 수 없습니다. 다른 파일로 시도해주세요.'
      : aiErrorText(e);
  }
}

function restartDay(){
  state.simMinutes = DAY_START;
  state.doneForDay = false;
  state.playing = false;
  state.dataLog = [];
  state.eventLog = [];
  state.systemLog = [];
  state.dog = { idx:0, current:null };
  document.getElementById('dayEndBanner').style.display = 'none';
  document.getElementById('playBtn').textContent = '▶ 재생';
  document.getElementById('clockLabel').textContent = fmtClock(DAY_START);
  const START_ROOM = { dad:'안방', mom:'안방', kid:'아이방' };
  ['mom','dad','kid'].forEach(id => {
    state.people[id] = {
      current: { location: START_ROOM[id], action:'기상 준비', thought:'', quote:'', attitude:'', emotion:'', data_tag:'', ai_interaction:'', startMin: DAY_START, endMin: DAY_START },
      fetching:false, log:[]
    };
  });
  renderDataLog(); renderEventLog(); renderSystemLog();
  ['mom','dad','kid'].forEach((id, i) => {
    state.people[id].fetching = true;
    renderBubble(id, state.people[id].current, true);
    setTimeout(() => decideNext(id, '하루의 시작, 기상 직후'), i * 1500);
  });
  const s0 = DOG_SCRIPT[0];
  state.dog.current = { location:s0.location, action:s0.action, startMin: DAY_START, endMin: DAY_START + s0.duration };
  state.dog.idx = 1;
  renderDog();
}

function showHoverPopup(id){
  hideHoverPopup();
  const wrap = state.avatarEls[id];
  if (!wrap) return;
  const rect = wrap.getBoundingClientRect();
  const pop = document.createElement('div');
  pop.className = 'hover-popup';
  pop.id = 'hoverPopup';
  let html = '';
  if (id === 'dog') {
    const d = state.dog.current;
    html = `<div class="hp-title">🐶 강아지 보리</div>` + (d ? `<div class="hp-line">📍 ${d.location}</div><div class="hp-line">🎬 ${escapeHtml(d.action)}</div>` : '');
  } else {
    const cur = state.people[id].current;
    html = `<div class="hp-title">${PERSONAS[id].emoji} ${displayName(id)}</div>`;
    if (cur){
      html += `<div class="hp-line">📍 ${cur.location} · ${cur.time}</div>`;
      html += `<div class="hp-line">🎬 ${escapeHtml(cur.action)}</div>`;
      if (cur.thought) html += `<div class="hp-line hp-think">💭 ${escapeHtml(cur.thought)}</div>`;
      if (cur.quote) html += `<div class="hp-line">"${escapeHtml(cur.quote)}"</div>`;
      if (cur.attitude || cur.emotion) html += `<div class="hp-line">${cur.attitude ? '🧭 '+escapeHtml(cur.attitude) : ''}${cur.attitude && cur.emotion ? ' · ' : ''}${cur.emotion ? '❤️ '+escapeHtml(cur.emotion) : ''}</div>`;
      if (cur.data_tag) html += `<div class="hp-line hp-data">📊 ${escapeHtml(cur.data_tag)}</div>`;
      if (cur.ai_interaction) html += `<div class="hp-line hp-ai">🔊 ${escapeHtml(cur.ai_interaction)}</div>`;
    } else {
      html += `<div class="hp-line">...</div>`;
    }
  }
  pop.innerHTML = html;
  document.body.appendChild(pop);
  pop.style.left = (rect.left + rect.width/2) + 'px';
  pop.style.top = rect.top + 'px';
}
function hideHoverPopup(){
  const old = document.getElementById('hoverPopup');
  if (old) old.remove();
}

function openSettings(){
  buildSettingsPanel();
  document.getElementById('settingsPanel').style.display = 'block';
}

function buildSettingsPanel(){
  document.getElementById('setSituation').value = FAMILY_CONTEXT.situation;
  document.getElementById('setDevices').value = FAMILY_CONTEXT.devices;
  const list = document.getElementById('personaEditList');
  list.innerHTML = ['mom','dad','kid'].map(id => {
    const p = PERSONAS[id];
    return `
    <div class="persona-edit-group">
      <h4>${p.emoji} ${ROLE_LABEL[id]}</h4>
      <div class="persona-edit-row"><label>이름</label><input data-pid="${id}" data-field="name" value="${p.name}"></div>
      <div class="persona-edit-row"><label>나이</label><input data-pid="${id}" data-field="age" value="${p.age}"></div>
      <div class="persona-edit-row"><label>직업</label><input data-pid="${id}" data-field="job" value="${p.job}"></div>
      <div class="persona-edit-row"><label>성격</label><input data-pid="${id}" data-field="personality" value="${p.personality}"></div>
      <div class="persona-edit-row"><label>AI 친숙도</label>
        <select data-pid="${id}" data-field="aiLevel">
          <option value="전문가" ${p.aiLevel==='전문가'?'selected':''}>전문가</option>
          <option value="중간" ${p.aiLevel==='중간'?'selected':''}>중간</option>
          <option value="낮음" ${p.aiLevel==='낮음'?'selected':''}>낮음</option>
        </select>
      </div>
      <div class="persona-edit-row persona-edit-notes"><label>자유 메모</label><textarea data-pid="${id}" data-field="notes" placeholder="자유롭게 특징을 적어보세요 (예: 최근 다이어트 시작, 알레르기 있음 등)">${p.notes||''}</textarea></div>
    </div>`;
  }).join('');
}

function saveSettings(){
  FAMILY_CONTEXT.situation = document.getElementById('setSituation').value.trim();
  FAMILY_CONTEXT.devices = document.getElementById('setDevices').value.trim();
  document.querySelectorAll('#personaEditList [data-pid]').forEach(el => {
    const pid = el.dataset.pid, field = el.dataset.field;
    const val = el.value.trim();
    PERSONAS[pid][field] = field === 'age' ? (Number(val) || PERSONAS[pid][field]) : val;
  });
  buildFamilyList();
  document.getElementById('settingsPanel').style.display = 'none';
}

function initEvents(){
  document.getElementById('playBtn').onclick = () => {
    if (state.doneForDay) return;
    state.playing = !state.playing;
    document.getElementById('playBtn').textContent = state.playing ? '⏸ 일시정지' : '▶ 재생';
  };
  document.getElementById('restartBtn').onclick = restartDay;
  document.getElementById('speedSel').onchange = (e) => { state.speed = Number(e.target.value); };
  document.getElementById('taskBtn').onclick = injectTask;
  document.querySelectorAll('.tab-btn').forEach(btn => {
    btn.onclick = () => {
      document.querySelectorAll('.tab-btn').forEach(b=>b.classList.remove('active'));
      document.querySelectorAll('.tab-content').forEach(c=>c.classList.remove('active'));
      btn.classList.add('active');
      document.getElementById('tab-'+btn.dataset.tab).classList.add('active');
    };
  });
  document.getElementById('interviewBtn').onclick = doInterview;
  document.getElementById('diaryBtn').onclick = doDiary;
  document.getElementById('surveyBtn').onclick = doSurvey;
  document.getElementById('diaryImageInput').onchange = (e) => {
    const files = Array.from(e.target.files || []);
    document.getElementById('diaryImagePreview').innerHTML =
      files.map(f => `<span class="chip">🖼 ${escapeHtml(f.name)}</span>`).join('');
  };
  document.getElementById('settingsBtn').onclick = () => {
    const panel = document.getElementById('settingsPanel');
    if (panel.style.display === 'none') openSettings();
    else panel.style.display = 'none';
  };
  document.getElementById('aiRetryBtn').onclick = retryAi;
  document.getElementById('saveSettingsBtn').onclick = saveSettings;
  document.getElementById('simDateInput').onchange = (e) => { simDateStr = e.target.value || simDateStr; };
  window.addEventListener('resize', () => {
    ['mom','dad','kid'].forEach(renderOne);
    renderDog();
  });
}

async function init(){
  buildHouse();
  buildFamilyList();
  initEvents();
  document.getElementById('simDateInput').value = simDateStr;
  document.getElementById('surveyQuestionsInput').value = SURVEY_QUESTIONS.join('\n');
  if (window.claude){
    try { sample = await claude.use('sample'); } catch(e){ sample = null; }
  }
  loopTimer = setInterval(loopTick, 300);
  if (sample){
    setAiStatus('ok');
    try {
      const limits = await sample.limits();
      if (limits.images) {
        const row = document.getElementById('diaryImageRow');
        row.style.display = 'flex';
        document.getElementById('diaryImageInput').accept = limits.images.mediaTypes.join(',');
      }
    } catch(e) { /* leave the image input hidden */ }
  } else {
    setAiStatus('none');
  }
  restartDay();
  state.playing = true;
  document.getElementById('playBtn').textContent = '⏸ 일시정지';
}

init();
</script>
